+def clear_transition_visual():
+    HOME.clearProperty('TherandInline45.TransitionVisual')
+    HOME.clearProperty('TherandInline45.TransitionTitle')
+
+
+def set_transition_visual(title):
+    if title:
+        HOME.setProperty('TherandInline45.TransitionTitle', title)
+        HOME.setProperty('TherandInline45.TransitionVisual', 'true')
+    else:
+        clear_transition_visual()
+
+
+def pagination_title_from_label(label):
+    match = re.search(r'\((\d+)\)\s*$', clean_label(label))
+    if not match:
+        return ''
+    return 'Vers page n°{}'.format(match.group(1))
+
+
+def pagination_title_from_url(url):
+    try:
+        page = dict(parse_qsl(urlsplit(url).query, keep_blank_values=True)).get('page', '')
+    except Exception:
+        page = ''
+    return 'Vers page n°{}'.format(page) if str(page).isdigit() else ''
+
+
 def unlock_nav():
+    clear_transition_visual()
     HOME.clearProperty('TherandInline45.NavBusy')
 
 
